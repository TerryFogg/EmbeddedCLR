CONFIG_TARGET_BOARD="ESP32_P4"
CONFIG_TARGET_SERIES="ESP32_P4"
CONFIG_RTOS_ESP32=y
# CONFIG_RTOS_CHIBIOS is not set
# CONFIG_RTOS_FREERTOS is not set
# CONFIG_RTOS_TI_SIMPLELINK is not set
# CONFIG_RTOS_THREADX is not set
CONFIG_RTOS="ESP32"

#
# Build Options
#
# CONFIG_NF_BUILD_RTM is not set
# CONFIG_NF_TARGET_HAS_NANOBOOTER is not set
# CONFIG_NF_ENABLE_DOUBLE_PRECISION_FP is not set
CONFIG_NF_SUPPORT_ANY_BASE_CONVERSION=y
CONFIG_NF_FEATURE_USE_RNG=y
CONFIG_NF_SECURITY_MBEDTLS=y
# CONFIG_NF_CLR_NO_TRACE is not set
# CONFIG_NF_CLR_NO_IL_INLINE is not set
# end of Build Options

#
# nanoFramework Features
#
CONFIG_NF_FEATURE_DEBUGGER=y
CONFIG_NF_FEATURE_RTC=y
CONFIG_NF_FEATURE_HAS_SDCARD=y
CONFIG_NF_FEATURE_HAS_CONFIG_BLOCK=y
CONFIG_NF_FEATURE_USE_LITTLEFS=y
CONFIG_NF_FEATURE_HAS_ACCESSIBLE_STORAGE=y
# CONFIG_NF_FEATURE_HAS_USB_MSD is not set
# CONFIG_TARGET_HAS_WIFI is not set
CONFIG_NF_FEATURE_WATCHDOG=n
CONFIG_NF_FEATURE_SUPPORT_REFLECTION=y
CONFIG_NF_FEATURE_BINARY_SERIALIZATION=y
# CONFIG_NF_FEATURE_USE_APPDOMAINS is not set
# CONFIG_NF_FEATURE_LIGHT_MATH is not set
# CONFIG_NF_TRACE_TO_STDIO is not set
# end of nanoFramework Features

#
# nanoFramework APIs
#
CONFIG_API_SYSTEM_MATH=y
CONFIG_API_SYSTEM_NET=y
CONFIG_API_SYSTEM_DEVICE_GPIO=y
CONFIG_API_SYSTEM_DEVICE_SPI=y
CONFIG_API_SYSTEM_DEVICE_I2C=y
CONFIG_API_SYSTEM_DEVICE_I2C_SLAVE=y
CONFIG_API_SYSTEM_DEVICE_PWM=y
CONFIG_API_SYSTEM_DEVICE_ADC=y
# CONFIG_API_SYSTEM_DEVICE_DAC is not set
CONFIG_API_SYSTEM_DEVICE_I2S=y
CONFIG_API_SYSTEM_DEVICE_WIFI=y
# CONFIG_API_SYSTEM_DEVICE_USBSTREAM is not set
CONFIG_API_SYSTEM_IO_PORTS=y
CONFIG_API_SYSTEM_IO_FILESYSTEM=y
# CONFIG_API_NANOFRAMEWORK_DEVICE_ONEWIRE is not set
# CONFIG_API_NANOFRAMEWORK_DEVICE_CAN is not set
# CONFIG_API_NANOFRAMEWORK_DEVICE_BLUETOOTH is not set
CONFIG_API_NANOFRAMEWORK_GRAPHICS=y
CONFIG_API_NANOFRAMEWORK_RESOURCEMANAGER=y
CONFIG_API_NANOFRAMEWORK_SYSTEM_COLLECTIONS=y
CONFIG_API_NANOFRAMEWORK_SYSTEM_TEXT=y
CONFIG_API_NANOFRAMEWORK_SYSTEM_SECURITY_CRYPTOGRAPHY=y
CONFIG_API_NANOFRAMEWORK_SYSTEM_IO_HASHING=y
# CONFIG_API_NANOFRAMEWORK_NETWORKING_THREAD is not set
CONFIG_API_HARDWARE_ESP32=y
CONFIG_API_NANOFRAMEWORK_HARDWARE_ESP32_RMT=y
CONFIG_API_NANOFRAMEWORK_RUNTIME_EVENTS=y
CONFIG_API_NANOFRAMEWORK_NETWORKING_SNTP=y
CONFIG_API_SYSTEM_RUNTIME_SERIALIZATION=y
# end of nanoFramework APIs

#
# Graphics
#
CONFIG_GRAPHICS_DISPLAY_ILI9341=y
# CONFIG_GRAPHICS_DISPLAY_ILI9342 is not set
# CONFIG_GRAPHICS_DISPLAY_ST7735S is not set
# CONFIG_GRAPHICS_DISPLAY_ST7789V is not set
# CONFIG_GRAPHICS_DISPLAY_GC9A01 is not set
# CONFIG_GRAPHICS_DISPLAY_OTM8009A is not set
# CONFIG_GRAPHICS_DISPLAY_GENERIC_SPI is not set
CONFIG_GRAPHICS_DISPLAY="ILI9341_240x320_SPI.cpp"
CONFIG_GRAPHICS_IFACE_SPI=y
# CONFIG_GRAPHICS_IFACE_DSI_VIDEO is not set
CONFIG_GRAPHICS_DISPLAY_INTERFACE="Spi_To_Display.cpp"
# CONFIG_TOUCH_XPT2046=y
# CONFIG_TOUCH_FT6X06 is not set
# CONFIG_TOUCH_CST816S is not set
# CONFIG_TOUCH_STMPE811QTR is not set
# CONFIG_TOUCHPANEL_DEVICE="XPT2046.cpp"
# CONFIG_TOUCH_IFACE_SPI=y
# CONFIG_TOUCH_IFACE_I2C is not set
# CONFIG_TOUCHPANEL_INTERFACE="Spi_To_TouchPanel.cpp"
CONFIG_GRAPHICS_MEMORY=""
# end of Graphics

#
# Networking
#
CONFIG_NF_NETWORKING_SNTP=y
# CONFIG_NF_NETWORKING_ENC28J60 is not set
# end of Networking

#
# Wire Protocol Transport
#
CONFIG_NF_WP_TRANSPORT_SERIAL=y
# CONFIG_NF_WP_TRANSPORT_USB_CDC is not set
CONFIG_TARGET_SERIAL_BAUDRATE=921600
# end of Wire Protocol Transport

#
# Wire Protocol
#
# CONFIG_NF_WP_ENABLE_CRC32 is not set

#
# Wire Protocol Trace
#
# CONFIG_NF_WP_TRACE_ERRORS is not set
# CONFIG_NF_WP_TRACE_HEADERS is not set
# CONFIG_NF_WP_TRACE_STATE is not set
# CONFIG_NF_WP_TRACE_NODATA is not set
# CONFIG_NF_WP_TRACE_VERBOSE is not set
# CONFIG_NF_WP_TRACE_ALL is not set
# end of Wire Protocol Trace
# end of Wire Protocol

#
# ESP32 Platform
#
CONFIG_SDK_CONFIG_FILE="sdkconfig.default.rev.less3.esp32p4"
CONFIG_ESP32_RESERVE_SPIRAM_IDF_ALLOCATION_BYTES=262144
CONFIG_ESP32_RESERVE_IRAM_IDF_ALLOCATION_KB=0
# CONFIG_ESP32_USB_CDC is not set
# CONFIG_ESP32_XTAL_FREQ_26 is not set
CONFIG_ESP32_ETHERNET_PHY_CLOCK_MODE=""
CONFIG_ESP32_ETHERNET_PHY_POWER_PIN=""

#
# ESP32 Ethernet
#
CONFIG_ESP32_ETHERNET_SUPPORT=y
CONFIG_ESP32_ETHERNET_PHY_IP101=y
# CONFIG_ESP32_ETHERNET_PHY_LAN8720 is not set
# CONFIG_ESP32_ETHERNET_PHY_RTL8201 is not set
CONFIG_ESP32_ETHERNET_INTERFACE="IP101"
CONFIG_ESP32_ETHERNET_PHY_ADDR=1
CONFIG_ESP32_ETHERNET_MDC_GPIO=31
CONFIG_ESP32_ETHERNET_MDIO_GPIO=52
CONFIG_ESP32_ETHERNET_RMII_CLK_OUT_GPIO=-1
CONFIG_ESP32_ETHERNET_RMII_CLK_IN_GPIO=-1
CONFIG_ESP32_ETHERNET_PHY_RST_GPIO=51
# end of ESP32 Ethernet
# end of ESP32 Platform
