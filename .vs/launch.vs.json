            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/Terry/.espressif/tools/riscv32-esp-elf-gdb/17.1_20260402/riscv32-esp-elf-gdb/bin/riscv32-esp-elf-gdb.exe",
            "miDebuggerServerAddress": "localhost:3333",
            "stopOnEntry": true,
            "debugServerPath": "C:/Users/Terry/.espressif/tools/openocd-esp32/v0.12.0-esp32-20260831/openocd-esp32/bin/openocd.exe",
