{
    "version": "0.2.1",
    "tasks": [
        {
            "taskLabel": "Erase ESP32-P4 flash",
            "appliesTo": "*.*",
            "type": "default",
            "command": "${env.COMSPEC}",
            "args": [
                "python -m esptool --chip esp32p4 -p COM3 --baud 460800 --before default_reset --after hard_reset erase_flash"
            ]
        },
        {
            "taskLabel": "VERIFY ESP32-P4",
            "appliesTo": "*.*",
            "type": "default",
            "command": "${env.COMSPEC}",
            "args": [
                "cd build && dir && python -m esptool --chip esp32p4 -p COM3 flash_id"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/c"
                        ]
                    }
                }
            }
        },
        {
            "taskLabel": "Flash ESP32-P4",
            "appliesTo": "*.*",
            "type": "default",
            "command": "${env.COMSPEC}",
            "args": [
                "cd build && python -m esptool --chip esp32p4 -p COM3 -b 460800 --before default_reset --after hard_reset write_flash @flash_args"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/c"
                        ]
                    }
                }
            }
        }
    ]
}
