{
    "version": 4,
    "configurePresets": [
        {
            "name": "general-preset",
            "description": "Preset with general configurations common to all presets",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "architecture": {
                "value": "unspecified",
                "strategy": "external"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "linux-gcc-arm"
                }
            },
            "warnings": {
                "deprecated": true,
                "dev": true,
                "uninitialized": false,
                "unusedCli": false
            },
            "environment": {
                "CMAKE_BUILD_PARALLEL_LEVEL": "24"
            }
        },
        {
            "name": "debug",
            "description": "This is non_optimized and contains all the debug symbols",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ESP32P4_REVISION": "PRE_V3"
            }
        },
        {
            "name": "release",
            "description": "This is optimized for speed without debugging symbols and with asserts disabled.",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ESP32P4_REVISION": "PRE_V3"
            }
        },
        {
            "name": "ESP32_P4_WIFI6",
            "inherits": [
                "general-preset"
            ],
            "hidden": true,
            "environment": {
                "PATH": "$penv{PATH};C:/users/terry/.espressif/tools/riscv32-esp-elf/esp-14.2.0_20260121/riscv32-esp-elf/bin",
                "IDF_PATH": "C:/users/terry/esp/v5.4.4/esp-idf",
                "ESP_IDF_VERSION": "5.5"
            },
            "cacheVariables": {
                "TARGET_NAME": "WaveShare ESP32-WIFI6-Touch",
                "TARGET_FAMILY": "Esp32",
                "TARGET_BOARD": "ESP32_P4",
                "TARGET_SERIES": "esp32p4",
                "ESP32P4_REVISION": "V1.3",
                "VENDOR": "Espressif",
                "PSRAM": true,
                "FLASH_SIZE": "32MB",

                "ESP32_IDF_PATH": "C:/users/terry/esp/v5.4.4/esp-idf",
                "ESP_TOOLCHAIN_DIR": "C:/Users/Terry/.espressif/tools/riscv32-esp-elf/esp-14.2.0_20260121/riscv32-esp-elf/bin",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/targets/Espressif/ESP32P4/toolchain.riscv32-esp32p4-elf.cmake",
                "NF_INTEROP_ASSEMBLIES": null,
                "BUILD_VERSION": "0.9.99.999",
                "BUILD_VERBOSE": "OFF",
                "CORE_FEATURES": "Collections=ON;ConfigBlock=OFF;Cryptography=OFF;FileSystem=OFF;Graphics=ON;Hashing=ON;Mathematics=ON;Network=OFF;Reflection=ON;ResourceManager=ON;RuntimeEvents=ON;RuntimeSerialization=ON;Text=ON;WireProtocol=ON",
                "IO_FEATURES": "Bluetooth=OFF;CAN=OFF;InterSound=OFF;OneWire=OFF;SerialPorts=OFF;UsbHost=OFF;UsbStream=OFF",
                "FEATURE_DEFINES": "ConfigBlock=OFF;GraphicsTouch=ON;Bluetooth=OFF;Ethernet=OFF;SNTP=OFF;Thread=OFF;WiFi=OFF",
                "ADVANCED_DEBUGGING": "Trace=OFF",
                "NF_SECURITY_MBEDTLS": true,
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "NF_TRACE_TO_STDIO": false
            }
        },

        // Build Presets for ESP32_P4_WIFI6
        {
            "name": "ESP32_P4_WIFI6_DEBUG",
            "inherits": [
                "ESP32_P4_WIFI6",
                "debug"
            ]
        },
        {
            "name": "ESP32_P4_WIFI6_RELEASE",
            "inherits": [
                "ESP32_P4_WIFI6",
                "release"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "build_ESP32_P4_WIFI6_debug",
            "configurePreset": "ESP32_P4_WIFI6_DEBUG"
        },
        {
            "name": "build_ESP32_P4_WIFI6_release",
            "configurePreset": "ESP32_P4_WIFI6_RELEASE"
        }
    ]
